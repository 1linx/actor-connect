# TMDB credentials. Either works — the app detects which one you've supplied.
#
#  - v3 API key: the short hex string from
#    https://www.themoviedb.org/settings/api ("API Key")
#  - v4 read access token: the long JWT on the same page
#    ("API Read Access Token") — set TMDB_READ_ACCESS_TOKEN instead
#
# Only the puzzle builder ever spends these, and only for a film it has never
# seen: every response is written to SQLite and reused from then on. Playing a
# puzzle makes no TMDB calls at all.
TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=

# The builder at /build (and the TMDB-spending endpoints behind it) is open in
# `vite dev` and closed in production. Set this to 1 to open it in production
# too — only do that behind your own auth, e.g. a Laravel-proxied route.
# PUZZLE_EDITOR=1

# How src/lib/server/library.json relates to the database on boot:
#   empty  (default) seed only a database with no puzzles — author on the instance
#   merge  write every seed puzzle on every boot — library.json is canonical
#   off    never seed
# Production sets this to `merge` in ecosystem.config.cjs. Don't set it in
# development: a local edit you haven't exported would be reverted on the next
# hot reload.
# PUZZLE_SEED=merge

# Where the SQLite database lives. Holds the puzzles and the durable TMDB
# cache; created on first run, seeded from src/lib/server/library.json. Back it
# up — it is the only copy of puzzles you haven't exported back to the seed.
# DATABASE_PATH=data/actor-connect.db
